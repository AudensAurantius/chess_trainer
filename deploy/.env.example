# Chess Trainer deployment environment variables
# Copy to deploy/.env and fill in values:  cp deploy/.env.example deploy/.env

# ── Authentication ───────────────────────────────────────────────────────────

# Enable user authentication (required for multi-tenant deployment)
CHESS_TRAINER_AUTH_ENABLED=true

# Require invite codes for registration
CHESS_TRAINER_AUTH_REQUIRE_INVITE=true

# Session expiry in hours (default: 720 = 30 days)
# CHESS_TRAINER_AUTH_SESSION_EXPIRY_HOURS=720

# ── Database ─────────────────────────────────────────────────────────────────

# Data directory inside the container (mapped to chess-data volume)
# Default: /data — generally no need to change this
# CHESS_TRAINER_DATA_DIR=/data

# Auth database path (inside container)
# CHESS_TRAINER_AUTH_DATABASE_PATH=/data/auth.db

# ── Web Server ───────────────────────────────────────────────────────────────

# Bind address and port (inside container, proxied by Caddy)
# CHESS_TRAINER_WEB_HOST=0.0.0.0
# CHESS_TRAINER_WEB_PORT=8000

# ── Lichess API ──────────────────────────────────────────────────────────────

# Optional: Lichess API token for higher rate limits on public endpoints
# (opening explorer, public game export). NOT required for basic operation.
# Per-user tokens for personal data access are managed at the application level.
# CHESS_TRAINER_LICHESS_TOKEN=lip_xxxxxxxxxxxxxxxxxxxxx
